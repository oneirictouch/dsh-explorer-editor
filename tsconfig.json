{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    // The Desktop-app profile bundles strip .d.ts files, so tsc cannot read
    // types from node_modules/@deepseek-ai (a symlink to the active profile).
    // These paths map the *compile-time* lookup to the global dsh install
    // (which ships types); runtime resolution is untouched (Node walks the
    // node_modules symlink and loads the same instance as the app gateway).
    //
    // ENVIRONMENT-SPECIFIC: the "v22.21.0" segment below is the nvm-managed
    // Node version directory and must match the local install. If your global
    // dsh lives elsewhere, change it. If the active profile keeps its .d.ts
    // (typical web-profile development), you can remove this "paths" block
    // entirely and resolve types straight from node_modules/@deepseek-ai.
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/*": ["../../../.nvm/versions/node/v22.21.0/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/*"]
    }
  },
  "include": ["src"]
}
